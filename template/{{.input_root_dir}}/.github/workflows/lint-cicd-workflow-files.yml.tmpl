name: Lint CI/CD workflow files
on:
  pull_request:
    paths:
      - '.github/workflows/**'
  workflow_dispatch:
  
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Download actionlint
        id: get_actionlint
        # Fetch the installer from a pinned release tag (not the mutable `main`
        # branch) and install that exact actionlint version.
        run: bash <(curl https://raw.githubusercontent.com/rhysd/actionlint/v1.7.12/scripts/download-actionlint.bash) 1.7.12
        shell: bash
      - name: Check workflow files
        {{`run: ${{ steps.get_actionlint.outputs.executable }} -color`}}
        shell: bash
