FROM library/ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get -y install python3-pip curl unzip openjdk-11-jdk
RUN curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/{{template `cli_version` .}}/install.sh | sh
RUN pip install requests 
COPY {{template `project_name_alphanumeric_underscore` .}}/requirements.txt .
COPY test-requirements.txt .
RUN pip install -r requirements.txt
RUN pip install -r test-requirements.txt
